<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Studio Beleza & Arte</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Cabeçalho / Menu -->
    <header>
        <div class="logo">Studio Beleza</div>
        <nav>
            <a href="#sobre">Sobre</a>
            <a href="#servicos">Serviços</a>
            <a href="#contato" class="btn-contato">Agendar Horário</a>
        </nav>
    </header>

    <!-- Banner Principal -->
    <section class="hero">
        <h1>Realce sua beleza natural</h1>
        <p>Especialistas em cabelos, unhas e estética avançada.</p>
        <a href="https://wa.me/seu-numero" target="_blank" class="btn-whatsapp">Agende pelo WhatsApp</a>
    </section>

    <!-- Serviços -->
    <section id="servicos">
        <h2>Nossos Serviços</h2>
        <div class="cards-servicos">
            <div class="card">
                <h3>Cabelo</h3>
                <p>Cortes, coloração, mechas e tratamentos personalizados.</p>
            </div>
            <div class="card">
                <h3>Unhas</h3>
                <p>Manicure, pedicure e alongamento em gel.</p>
            </div>
            <div class="card">
                <h3>Estética</h3>
                <p>Design de sobrancelhas, maquiagem e limpeza de pele.</p>
            </div>
        </div>
    </section>

    <!-- Rodapé -->
    <footer>
        <p>&copy; 2026 Studio Beleza. Todos os direitos reservados.</p>
    </footer>

</body>
</html>
